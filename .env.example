MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
FABFLIX_DB_USER=fabflix
FABFLIX_DB_PASSWORD=replace-with-a-local-app-password
FABFLIX_DB_URL=jdbc:mysql://localhost:3307/moviedb
RECAPTCHA_SECRET_KEY=replace-with-your-recaptcha-secret

# AI (optional; leave untouched to keep AI disabled)
# Ollama endpoint. Defaults to localhost; put a LAN/remote endpoint here (never commit a real address)
FABFLIX_AI_OLLAMA_BASE_URL=http://localhost:11434
# chat / embedding model names (must already be pulled on the Ollama side)
FABFLIX_AI_CHAT_MODEL=qwen2.5:7b
FABFLIX_AI_EMBEDDING_MODEL=bge-m3
# AI master switch (default false: the health endpoint answers disabled and makes no network call)
FABFLIX_AI_ENABLED=false
